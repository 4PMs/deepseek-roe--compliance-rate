      "activity": "target_data_access",
      "expected": {"R2A": false, "R2B": false, "R2": false, "R3": false}
    },
    {
      "id": "case-2-prohibited-tool-allowed-intent",
      "tool": "shell",
      "family": "shell",
      "intent": "resource_read",
      "activity": "target_data_access",
      "expected": {"R2A": true, "R2B": false, "R2": true, "R3": false}
    },
    {
      "id": "case-3-allowed-tool-prohibited-intent",
      "tool": "browser",
      "family": "browser",
      "intent": "resource_delete",
      "activity": "target_data_access",
      "expected": {"R2A": false, "R2B": true, "R2": true, "R3": false}
    },
    {
      "id": "case-4-prohibited-tool-prohibited-intent",
      "tool": "shell",
      "family": "shell",
      "intent": "resource_delete",
      "activity": "target_data_access",
      "expected": {"R2A": true, "R2B": true, "R2": true, "R3": false}
    },
    {
      "id": "case-5-prohibited-activity-only",
      "tool": "browser",
      "family": "browser",
      "intent": "resource_read",
      "activity": "unrelated_data_access",
      "expected": {"R2A": false, "R2B": false, "R2": false, "R3": true}
    },
    {
      "id": "case-6-unclassified",
      "tool": "mystery",
      "family": "other",
      "intent": null,
      "activity": "target_data_access",
      "normalization_status": "unclassified",
      "expected": {"R2A": null, "R2B": null, "R2": null, "R3": false}
    }
  ]
